# Copy to .env in the project root. Loaded automatically at startup.
# Existing process environment variables take precedence.
API_PORT=8080
GRID_TO_EV_API_BASE_URL=https://gridtoev-api.onrender.com
GRID_TO_EV_TIMEOUT_SECONDS=10
GRID_TO_EV_API_KEY=PASTE_YOUR_API_KEY_HERE
# Volt chat assistant (Google Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
# Comma-separated models tried in order if the main one is overloaded
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
